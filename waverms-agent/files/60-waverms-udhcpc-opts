#!/bin/sh
# UCI defaults: request WaveRMS DHCP options on the wan interface.
# Runs once on first boot via /etc/init.d/boot, then deleted.
# Options requested:
#   224 — bootstrap token
#   225 — BROKER_HOST
#   226 — BROKER_PORT
#
# netifd reads 'reqopts' as space-separated option numbers and passes
# each as a -O flag to udhcpc — do not include -O here.

# No "wan" section (differently named WAN, or none): "uci set" would fail with
# "uci: Invalid argument", leaving this script in place to fail on every boot.
uci -q get network.wan >/dev/null || exit 0

EXISTING=$(uci -q get network.wan.reqopts)
case "$EXISTING" in
    *224*) ;;  # already configured, nothing to do
    "")
        uci set network.wan.reqopts='224 225 226'
        uci commit network
        ;;
    *)
        uci set network.wan.reqopts="$EXISTING 224 225 226"
        uci commit network
        ;;
esac
