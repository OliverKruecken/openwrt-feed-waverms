#!/bin/sh
# udhcpc user hook: write WaveRMS bootstrap token and broker config from DHCP.
#
# Installed to /etc/udhcpc.user.d/ — sourced by /lib/netifd/dhcp.script on
# every udhcpc event. Only acts on bound/renew; exits silently on deconfig.
#
# DHCP options used:
#   224 — bootstrap token  → /etc/waverms/bootstrap_token
#   225 — BROKER_HOST      → /etc/waverms/dhcp
#   226 — BROKER_PORT      → /etc/waverms/dhcp
#
# Request all three from the DHCP server by adding to /etc/config/network:
#   option udhcpc_opts '-O 224 -O 225 -O 226'

[ "$1" = "bound" ] || [ "$1" = "renew" ] || exit 0

TOKEN="${opt224}"
if [ -n "$TOKEN" ]; then
    # Skip if bootstrap is already complete.
    [ -f /etc/waverms/credentials ] && exit 0
    # Skip if a baked-in token is already present.
    [ -f /etc/waverms/bootstrap_token ] && exit 0

    mkdir -p /etc/waverms
    printf '%s' "$TOKEN" > /etc/waverms/bootstrap_token
    chmod 600 /etc/waverms/bootstrap_token
fi

# Broker config (options 225 / 226) is written on every DHCP bound/renew so
# the agent always reflects the current provisioning network's broker address.
BROKER_HOST_OPT="${opt225}"
BROKER_PORT_OPT="${opt226}"
if [ -n "$BROKER_HOST_OPT" ] || [ -n "$BROKER_PORT_OPT" ]; then
    mkdir -p /etc/waverms
    {
        [ -n "$BROKER_HOST_OPT" ] && printf 'BROKER_HOST=%s\n' "$BROKER_HOST_OPT"
        [ -n "$BROKER_PORT_OPT" ] && printf 'BROKER_PORT=%s\n' "$BROKER_PORT_OPT"
    } > /etc/waverms/dhcp
    chmod 600 /etc/waverms/dhcp
fi
