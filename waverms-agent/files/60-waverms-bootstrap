#!/bin/sh
# udhcpc user hook: write WaveRMS bootstrap token and broker config from DHCP.
#
# Installed to /etc/udhcpc.user.d/ — sourced by /lib/netifd/dhcp.script on
# every udhcpc event. Only acts on bound/renew; exits silently on deconfig.
#
# DHCP options used:
#   224 — bootstrap token  → /etc/waverms/bootstrap_token
#   225 — BROKER_HOST      → /etc/waverms/dhcp
#   226 — BROKER_PORT      → /etc/waverms/dhcp
#
# BusyBox udhcpc passes custom options (224+) as hex strings. hex_to_str and
# hex_to_int decode them before writing.
#
# Request all three from the DHCP server by adding to /etc/config/network:
#   option udhcpc_opts '-O 224 -O 225 -O 226'

log() { logger -t waverms-dhcp "$*"; }

[ "$1" = "bound" ] || [ "$1" = "renew" ] || exit 0

# opt224 is the bootstrap token itself (hex-encoded) — never log its value,
# only whether one was received, so it doesn't end up in logd / the log
# snapshot the backend and frontend can read.
opt224_status="(none)"
[ -n "$opt224" ] && opt224_status="present"
log "action=$1 opt224=$opt224_status opt225=${opt225:-(none)} opt226=${opt226:-(none)}"

# Decode a hex string to UTF-8 text (e.g. "6d717474" → "mqtt").
# Uses sed + printf \x escapes — BusyBox awk lacks strtonum.
hex_to_str() {
    [ -n "$1" ] || return
    printf "$(printf '%s' "$1" | sed 's/../\\x&/g')"
}

# Decode a big-endian hex string to a decimal integer (e.g. "22b3" → 8883).
hex_to_int() {
    printf '%d' "0x$1" 2>/dev/null
}

TOKEN="$(hex_to_str "${opt224}")"
if [ -n "$TOKEN" ]; then
    if [ -f /etc/waverms/credentials ]; then
        log "skipping bootstrap_token: credentials already present"
        exit 0
    fi
    if [ -f /etc/waverms/bootstrap_token ]; then
        log "skipping bootstrap_token: token already present"
        exit 0
    fi
    mkdir -p /etc/waverms
    printf '%s' "$TOKEN" > /etc/waverms/bootstrap_token
    chmod 600 /etc/waverms/bootstrap_token
    log "wrote bootstrap_token"
else
    log "opt224 not received or empty — no bootstrap_token written"
fi

# Broker config (options 225 / 226) is written on every DHCP bound/renew so
# the agent always reflects the current provisioning network's broker address.
BROKER_HOST_OPT="$(hex_to_str "${opt225}")"
BROKER_PORT_OPT="$(hex_to_int "${opt226}")"
if [ -n "$BROKER_HOST_OPT" ] || [ -n "$BROKER_PORT_OPT" -a "$BROKER_PORT_OPT" != "0" ]; then
    mkdir -p /etc/waverms
    {
        [ -n "$BROKER_HOST_OPT" ] && printf 'BROKER_HOST=%s\n' "$BROKER_HOST_OPT"
        [ -n "$BROKER_PORT_OPT" ] && [ "$BROKER_PORT_OPT" != "0" ] && printf 'BROKER_PORT=%s\n' "$BROKER_PORT_OPT"
    } > /etc/waverms/dhcp
    chmod 600 /etc/waverms/dhcp
    log "wrote /etc/waverms/dhcp: BROKER_HOST=${BROKER_HOST_OPT} BROKER_PORT=${BROKER_PORT_OPT}"
else
    log "opt225/opt226 not received — no dhcp overlay written"
fi
