#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/waverms-agent
    # respawn <threshold> <timeout> <retry>
    # threshold: process must run for at least this many seconds to not count as a crash.
    # timeout:   seconds to wait before restarting.
    # retry:     max crash count before giving up (0 = unlimited — avoided here to prevent
    #            infinite crash-loops; logd will record the failure for diagnosis).
    procd_set_param respawn 3600 5 5
    # Give the agent time to send MQTT DISCONNECT before SIGKILL fires; without this
    # the broker triggers the LWT and marks the device offline on every intentional restart.
    procd_set_param term_timeout 15
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# No service_triggers()/reload_service(): a prior "restart on network reload" trigger here
# self-inflicted a restart on the agent's OWN config_apply committing the "network" package
# (uci commit fires the reload notification immediately, independent of whether
# /etc/init.d/network reload ever runs) — killing the connectivity watchdog goroutine before it
# could ack, so every config_apply touching network config timed out on the backend even though
# the config applied correctly on the device. Nothing else in this codebase depends on the agent
# restarting when network config reloads.
