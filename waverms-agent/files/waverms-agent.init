#!/bin/sh /etc/rc.common
# WaveRMS device agent – procd service definition

USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/share/waverms/agent.sh
    # Restart on crash; don't count retries over 3600 s; no hard retry limit
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}